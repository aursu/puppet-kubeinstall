<%- | String               $repository,
      String               $password,
      Hash[String, String] $env = {},
| -%>
### MANAGED BY PUPPET (kubeinstall::etcd::backup) — restic repository env (0600) ###
export RESTIC_REPOSITORY='<%= $repository %>'
export RESTIC_PASSWORD='<%= $password %>'
<% $env.each |$key, $value| { -%>
export <%= $key %>='<%= $value %>'
<% } -%>
