<%- | String        $env_file,
      String        $lockfile,
      String        $snapshot_dir,
      String        $endpoints,
      String        $cacert,
      String        $cert,
      String        $key,
      Array[String] $forget_flags,
| -%>
#!/usr/bin/env bash
# MANAGED BY PUPPET (kubeinstall::etcd::backup) — etcd snapshot → verify → restic
set -euo pipefail

# Serialise against the repository prune (shared lock, fd 9).
exec 9>'<%= $lockfile %>'
if ! flock -w 600 9; then
  echo "etcd backup: repository lock busy, skipping" >&2
  exit 1
fi

ts="$(date +%Y%m%d-%H%M%S)"
snap="<%= $snapshot_dir %>/etcd-snapshot-${ts}.db"

cleanup() { rm -f "$snap"; }
trap cleanup EXIT

# 1) Take the snapshot to a real file (never /dev/stdout — save needs a file).
ETCDCTL_API=3 etcdctl \
  --endpoints='<%= $endpoints %>' \
  --cacert='<%= $cacert %>' \
  --cert='<%= $cert %>' \
  --key='<%= $key %>' \
  snapshot save "$snap"

# 2) Verify the snapshot before trusting it (etcdutl is installed alongside etcdctl).
etcdutl snapshot status "$snap" >/dev/null

# 3) Load the repository env and back the verified snapshot up into restic.
set -a
# shellcheck disable=SC1090
source '<%= $env_file %>'
set +a
restic backup --tag etcd "$snap"

# 4) Per-tag retention (prune runs separately, on its own timer).
restic forget --tag etcd <%= $forget_flags.join(' ') %>
